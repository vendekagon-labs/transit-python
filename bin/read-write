#!/usr/bin/env python3
# Copyright (c) Cognitect, Inc.
# All rights reserved.

# Reads each transit value from stdin as it arrives and writes it back to
# stdout. Used by transit-format's verify harness via bin/roundtrip.
#
# usage: read-write [json|json-verbose|msgpack]

import os
import sys
from io import TextIOWrapper

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir))

from transit.reader import Reader
from transit.writer import Writer

protocol = sys.argv[1].replace("-", "_") if len(sys.argv) > 1 else "json"

if protocol == "msgpack":
    out = sys.stdout.buffer
else:
    out = TextIOWrapper(sys.stdout.buffer, encoding="utf-8", write_through=True)

reader = Reader(protocol)
writer = Writer(out, protocol)

try:
    for obj in reader.readeach(sys.stdin.buffer):
        writer.write(obj)
except (BrokenPipeError, KeyboardInterrupt):
    pass
