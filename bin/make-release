#!/bin/bash
# Stamps the release version (0.8.<revision>) into the package, and says how
# to release it.
set -e
cd `dirname $0`/..
VERSION=0.8.`bin/revision`
sed -i.bak "s/^__version__ = .*/__version__ = \"$VERSION\"/" transit/__init__.py
rm transit/__init__.py.bak
cat <<END
Version $VERSION. To release it:

  git commit -am "Release $VERSION"
  git tag v$VERSION
  git push origin main v$VERSION
END
